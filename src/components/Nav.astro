---
// The top of every page: the wordmark, four places to go, and the theme
// toggle. It sits on the page like a running head rather than floating over it.
// Off the home page, a small portrait sits beside the wordmark; the home page
// has its own, larger one, so there it's collapsed to nothing. It only moves
// when it first appears or goes: it fades in on arrival from elsewhere, grows
// in (easing the wordmark over) coming from the home page, and shrinks away
// going back to it. Between other pages it holds still.
import { Image } from 'astro:assets'
import avatar from '@/assets/colin.jpg'
import { pagePath } from '@/lib/path'

const path = pagePath(Astro.url)
const isHome = path === '/'

const links = [
  { name: 'Writing', href: '/writing' },
  { name: 'Projects', href: '/projects' },
  { name: 'Photography', href: '/photography' },
  { name: 'Contact', href: '/contact' },
]

const isActive = (href: string) => path.startsWith(href)
---

<header class="nav">
  <div class="container inner">
    <a href="/" class="home" aria-label="armstr.ng home">
      <Image
        src={avatar}
        alt=""
        widths={[28, 56, 84]}
        sizes="28px"
        format="webp"
        quality={82}
        loading="eager"
        class:list={['face', { away: isHome }]}
      />
      <span>armstr<span>.ng</span></span>
    </a>
    <!-- Where this page was opened from: the Navigation API knows, even going
         back; document.referrer is the fallback, though going back it names
         the page's original referrer. A prerendered page waits until it's
         shown. -->
    <script is:inline define:vars={{ isHome }}>
      ;(() => {
        const root = document.documentElement
        const arrive = () => {
          let from
          try {
            from = new URL(navigation.activation.from.url)
          } catch {
            try {
              from = new URL(document.referrer)
            } catch {}
          }
          const local = from && from.origin === location.origin
          const fromHome = local && from.pathname === '/'
          const face = isHome ? local && !fromHome && 'shrink' : !local ? 'fade' : fromHome && 'grow'
          if (face) root.setAttribute('data-face', face)
        }
        if (!document.prerendering) return arrive()
        document.addEventListener('prerenderingchange', arrive, { once: true })
      })()
    </script>

    <nav class="links" aria-label="Main">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.name}
          </a>
        ))
      }
    </nav>

    <button class="theme" type="button" onclick="toggleDarkMode(this)" aria-label="Toggle dark mode">
      <svg class="moon" viewBox="0 0 16 16" aria-hidden="true">
        <path
          d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linejoin="round"></path>
      </svg>
      <svg class="sun" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="8" cy="8" r="2.75" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
        <path
          d="M8 1.5v1.25M8 13.25v1.25M1.5 8h1.25M13.25 8h1.25M3.4 3.4l.9.9M11.7 11.7l.9.9M3.4 12.6l.9-.9M11.7 4.3l.9-.9"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .nav {
    view-transition-name: nav;
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 30px;
  }

  .home {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 28px;
    margin-right: auto;
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .face {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--line);
  }

  .face.away {
    width: 0;
    height: 0;
    margin-right: -10px;
    opacity: 0;
  }

  :global(html[data-face='fade']) .face {
    animation: fade 200ms var(--ease) both;
  }

  /* The portrait grows from nothing, gap and all, or shrinks back to it, so
     the wordmark is pushed along by the layout rather than jumping. */
  :global(html[data-face='grow']) .face {
    animation: face-grow 420ms var(--ease) both;
  }

  :global(html[data-face='shrink']) .face {
    animation: face-shrink 420ms var(--ease) both;
  }

  @keyframes face-grow {
    from {
      width: 0;
      height: 0;
      margin-right: -10px;
      opacity: 0;
    }
  }

  @keyframes face-shrink {
    from {
      width: 28px;
      height: 28px;
      margin-right: 0;
      opacity: 1;
    }
  }

  .home span span {
    color: var(--ink-2);
    font-weight: 400;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 22px;
    color: var(--ink-2);
    font-size: 17px;
  }

  .links a:hover {
    color: var(--ink);
  }

  /* Where you are: darker, with the ink stroke under it. */
  .links a[aria-current] {
    color: var(--ink);
    background: linear-gradient(var(--blue-faint), var(--blue-faint)) no-repeat left bottom / 100% 1px;
    padding-bottom: 1px;
  }

  /* The circle hangs past the column, so it's the glyph, not the circle, that
     lines up with the edge of the text. */
  .theme {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    margin-right: -9px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
  }

  /* Only for a pointer: after a tap, the circle would stay lit. */
  @media (hover: hover) {
    .theme:hover {
      background: color-mix(in srgb, var(--ink) 6%, transparent);
      color: var(--ink);
    }
  }

  /* A fingertip-sized target around the small circle. */
  @media (pointer: coarse) {
    .theme::after {
      content: '';
      position: absolute;
      inset: -6px;
    }
  }

  .theme svg {
    width: 17px;
    height: 17px;
  }

  .theme .sun,
  :global(.dark) .theme .moon {
    display: none;
  }

  :global(.dark) .theme .sun {
    display: block;
  }

  /* On a phone the wordmark and the toggle share the top line, and the links
     spread across the line beneath, so Contact ends under the toggle. This
     starts below 520px rather than the site's usual 640px: one line fits from
     there, and on anything wider the spread-out links would drift apart. */
  @media (max-width: 519px) {
    .inner {
      flex-wrap: wrap;
      row-gap: 6px;
      padding-top: 20px;
    }

    .links {
      order: 1;
      width: 100%;
      justify-content: space-between;
      column-gap: 12px;
      font-size: 16px;
    }
  }

  /* The narrowest phones need smaller links for all four to fit. */
  @media (max-width: 339px) {
    .links {
      font-size: 15px;
    }
  }
</style>
