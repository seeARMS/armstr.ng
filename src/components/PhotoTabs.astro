---
// The Photography pages' tabs: every photo, each collection, and the map.
import { collections, type Collection } from '@/data/photos'
import { collectionKeys } from '@/lib/photos'

interface Props {
  current: 'all' | Collection | 'map'
  /** Photos per tab (tabCounts in src/lib/photos.ts). */
  counts: Record<string, number>
}

const { current, counts } = Astro.props

const tabs = [
  { key: 'all', name: 'All', href: '/photography' },
  ...collectionKeys.map((key) => ({ key, name: collections[key].name, href: `/photography/${key}` })),
  { key: 'map', name: 'Map', href: '/photography/map' },
]
---

<nav class="tabs" aria-label="Photography">
  {
    tabs.map((tab) => (
      <a href={tab.href} aria-current={tab.key === current ? 'page' : undefined}>
        <span class="stroke">{tab.name}</span>
        {counts[tab.key] && <span class="count">{counts[tab.key]}</span>}
      </a>
    ))
  }
</nav>

<style>
  /* Plain words in a row, like the header's links. The open one is in ink
     and keeps its stroke. Named, so it holds still while the page changes. */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 26px;
    margin-top: 36px;
    font-size: 18px;
    view-transition-name: photo-tabs;
  }

  .tabs a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: var(--ink-2);
  }

  .tabs a[aria-current] {
    color: var(--ink);
  }

  .tabs a[aria-current] .stroke {
    background-image: linear-gradient(var(--ink), var(--ink));
    background-position: left bottom;
    background-size: 100% 1px;
  }

  .tabs a[aria-current]:hover .stroke {
    color: var(--ink);
  }

  .tabs a:focus-visible {
    outline: none;
  }

  .tabs a:focus-visible .stroke {
    background-position: left bottom;
    background-size: 100% 1px;
    color: var(--blue);
  }

  .count {
    color: var(--ink-3);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 639px) {
    .tabs {
      gap: 6px 20px;
      margin-top: 28px;
      font-size: 17px;
    }
  }
</style>
