---
// Posts as rows between hairlines. With `byYear`, the year sits in its own
// column on the first post of each year, like an archive.
import { shortDate, year } from '@/lib/format'

interface Props {
  posts: { title: string; link: string; isoDate: string }[]
  byYear?: boolean
}

const { posts, byYear = false } = Astro.props
const rows = posts.map((post, i) => ({
  ...post,
  year: year(post.isoDate),
  firstOfYear: i === 0 || year(posts[i - 1].isoDate) !== year(post.isoDate),
}))
---

<ol class:list={['rows', 'posts', { 'by-year': byYear }]}>
  {
    rows.map((post) => (
      <li class:list={{ 'new-year': byYear && post.firstOfYear }}>
        <a href={post.link}>
          {byYear && <span class="year">{post.firstOfYear ? post.year : ''}</span>}
          <span class="title">
            <span class="stroke">{post.title}</span>
          </span>
          <time class="date" datetime={post.isoDate}>
            {byYear ? (
              <>
                {shortDate(post.isoDate)}<span class="with-year">, {post.year}</span>
              </>
            ) : (
              post.year
            )}
          </time>
        </a>
      </li>
    ))
  }
</ol>

<style>
  a {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 13px 0;
    font-size: 19px;
    line-height: 1.35;
  }

  /* Within a year, rows are separated more quietly than between years. */
  .by-year li:not(:last-child):has(+ li:not(.new-year)) {
    border-bottom-color: transparent;
    background: linear-gradient(var(--line), var(--line)) no-repeat right bottom / calc(100% - 88px) 1px;
  }

  .year {
    flex: none;
    width: 64px;
    color: var(--ink-3);
    font-size: 17px;
  }

  .title {
    flex: 0 1 auto;
    min-width: 0;
    text-wrap: pretty;
  }

  .date {
    flex: none;
    margin-left: auto;
    color: var(--ink-3);
    font-size: 17px;
  }

  /* The year column says it on wide screens; small screens fold it in. */
  .with-year {
    display: none;
  }

  @media (max-width: 639px) {
    a {
      gap: 16px;
      font-size: 18px;
    }

    .year {
      display: none;
    }

    .by-year li:not(:last-child):has(+ li:not(.new-year)) {
      border-bottom-color: var(--line);
      background: none;
    }

    .date {
      font-size: 15.5px;
    }

    .with-year {
      display: inline;
    }
  }
</style>
