---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import { person, socials } from '@/data/profile'
import { breadcrumbs, contactPage } from '@/lib/schema'

// The Markdown version of this page (contact.md.ts) repeats its copy; change both.
const listed = socials.filter((s) => s.listed !== false)
---

<Layout
  title="Contact Colin Armstrong"
  description="Get in touch with Colin Armstrong, founder and CEO of Paragraph. Founders building something early are especially welcome. Email is the best way to reach him."
  schema={[contactPage(), breadcrumbs([{ name: 'Contact', path: '/contact' }])]}
>
  <div class="container">
    <header class="page-head">
      <h1>Contact</h1>
      <p class="summary">
        I especially like hearing from founders building something early. Email is the best way to reach me: send a few
        lines on what you're building, who it's for, and where I could help.
      </p>
    </header>

    <section class="email" aria-label="Email">
      <a class="link address" href={`mailto:${person.email}`}>{person.email}</a>
      <button class="btn copy" type="button" data-copy={person.email}>
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <rect x="5.25" y="5.25" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"
          ></rect>
          <path
            d="M10.75 5.25V4a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 4v5.25a1.5 1.5 0 0 0 1.5 1.5h1.25"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"></path>
        </svg>
        <span data-label>Copy</span>
      </button>
      <!-- Filled in by the script below, and left out of contact.md.ts,
           since it changes by the minute. -->
      <p class="local-time" data-local-time hidden></p>
    </section>

    <section class="section" aria-labelledby="elsewhere">
      <div class="section-head">
        <h2 id="elsewhere">Elsewhere</h2>
      </div>
      <ul class="rows">
        {
          listed.map((s) => (
            <li>
              <a class="way" href={s.href} rel="me noopener">
                <svg class="icon" viewBox={s.viewBox ?? '0 0 24 24'} aria-hidden="true">
                  <path d={s.icon} />
                </svg>
                <span class="name">
                  <span class="stroke">{s.name}</span>
                </span>
                <span class="handle">
                  {s.handle}
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path
                      d="M5 11 11 5M6 5h5v5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>

<script>
  // "It's 9:42 pm for me in the Bay Area, 3 hours behind you."
  const localTime = document.querySelector<HTMLElement>('[data-local-time]')
  if (localTime) {
    const ZONE = 'America/Los_Angeles'
    const clock = new Intl.DateTimeFormat('en-US', { timeZone: ZONE, hour: 'numeric', minute: '2-digit' })
    // A zone's wall-clock time, read back as if it were UTC, so two zones'
    // times can be subtracted.
    const wall = (d: Date, timeZone?: string) => {
      const p = Object.fromEntries(
        new Intl.DateTimeFormat('en-US', { timeZone, hourCycle: 'h23', year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric' })
          .formatToParts(d)
          .map((x) => [x.type, Number(x.value)]),
      )
      return Date.UTC(p.year, p.month - 1, p.day, p.hour, p.minute)
    }
    const update = () => {
      const now = new Date()
      const time = clock.format(now).replace(/\s?([AP])M$/, (_, x: string) => ` ${x.toLowerCase()}m`)
      // In hours, to the nearest half: positive when the Bay Area is ahead.
      const gap = Math.round((wall(now, ZONE) - wall(now)) / 18e5) / 2
      const n = Math.abs(gap)
      const hours = `${Math.floor(n) || ''}${n % 1 ? '½' : ''} hour${n > 1 ? 's' : ''}`.replace(/^½ hours?$/, 'half an hour')
      const relative = gap === 0 ? 'the same time as you' : `${hours} ${gap > 0 ? 'ahead of' : 'behind'} you`
      localTime.textContent = `It's ${time} for me in the Bay Area, ${relative}.`
      localTime.hidden = false
    }
    update()
    setInterval(update, 15_000)
    document.addEventListener('prerenderingchange', update)
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = btn.querySelector('[data-label]')
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '')
        if (label) {
          label.textContent = 'Copied'
          setTimeout(() => (label.textContent = 'Copy'), 1600)
        }
      } catch {
        // Clipboard blocked: the address is still there to select.
      }
    })
  }
</script>

<style>
  /* The address is the page's one big thing. */
  .email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 44px;
  }

  .address {
    font-size: 36px;
    font-weight: 360;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .local-time {
    flex-basis: 100%;
    margin-top: -4px;
    color: var(--ink-3);
    font-size: 16px;
  }

  .copy {
    height: 36px;
    padding: 0 14px;
    color: var(--ink-2);
    font-size: 16px;
  }

  .copy:hover {
    color: var(--ink);
  }

  .way {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    font-size: 19px;
  }

  .icon {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--ink-2);
    fill: currentColor;
  }

  .name {
    flex: 1;
  }

  .handle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--ink-3);
    font-size: 17px;
  }

  .handle svg {
    width: 15px;
    height: 15px;
    transition: transform 220ms var(--ease);
  }

  .way:hover .icon,
  .way:hover .handle {
    color: var(--ink);
  }

  .way:hover .handle svg {
    transform: translate(2px, -2px);
  }

  @media (max-width: 639px) {
    .email {
      margin-top: 32px;
    }

    .address {
      font-size: 28px;
    }

    .way {
      font-size: 18px;
    }

    .handle {
      font-size: 16px;
    }
  }
</style>
