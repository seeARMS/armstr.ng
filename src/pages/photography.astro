---
export const prerender = true

import Lightbox from '@/components/Lightbox.astro'
import PhotoGrid from '@/components/PhotoGrid.astro'
import PhotoHead from '@/components/PhotoHead.astro'
import PhotoLicense from '@/components/PhotoLicense.astro'
import Layout from '@/layouts/Layout.astro'
import { getPhotos, mainCamera } from '@/lib/photos'
import { breadcrumbs, imageGallery } from '@/lib/schema'

// The Markdown version of this page (photography.md.ts) repeats its copy; change both.
const photos = await getPhotos()
// "mostly on a Canon EOS R5", from the photos themselves.
const camera = mainCamera(photos)
---

<Layout
  title="Wildlife, landscape & astrophotography"
  description="Photographs by Colin Armstrong: moose, birds, bobcats and howler monkeys, the Milky Way, Patagonia, Yosemite, Santorini and Big Sur, mostly shot on a Canon EOS R5."
  image="/photos/yosemite.jpg"
  schema={[
    imageGallery(photos.map((p) => ({ src: p.full, caption: p.caption, place: p.place?.label }))),
    breadcrumbs([{ name: 'Photography', path: '/photography' }]),
  ]}
>
  <div class="container wide">
    <PhotoHead current="all" camera={camera}>Open any photo to see how and where it was taken.</PhotoHead>
    <PhotoGrid photos={photos} />
    <PhotoLicense />
  </div>

  <Lightbox />
</Layout>
