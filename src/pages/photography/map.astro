---
// Where each photo was taken: the world's coastlines in hairline, drawn at
// build time (src/lib/atlas.ts), with a dot for each place and California
// enlarged in an inset. Beside the map (below it on narrow screens), the
// places, each opening to its photos. Pointing at a dot or a place marks the
// other, and fans out a few of its prints. Its Markdown version is map.md.ts.
export const prerender = true

import { Image } from 'astro:assets'
import Lightbox from '@/components/Lightbox.astro'
import PhotoDevelop from '@/components/PhotoDevelop.astro'
import PhotoHead from '@/components/PhotoHead.astro'
import PhotoLicense from '@/components/PhotoLicense.astro'
import PhotoThumb from '@/components/PhotoThumb.astro'
import { person } from '@/data/profile'
import Layout from '@/layouts/Layout.astro'
import { drawAtlas } from '@/lib/atlas'
import { byPlace, getPhotos } from '@/lib/photos'
import { breadcrumbs, imageGallery } from '@/lib/schema'

const places = byPlace(await getPhotos())
const total = places.reduce((n, p) => n + p.photos.length, 0)
const count = (n: number) => `${n} ${n === 1 ? 'photo' : 'photos'}`

// The dots appear in the order the places were first visited.
const firstVisit = (p: (typeof places)[number]) =>
  p.photos
    .map((photo) => photo.taken ?? '')
    .filter(Boolean)
    .sort()[0] ?? ''
const visits = [...places].sort((a, b) => firstVisit(a).localeCompare(firstVisit(b))).map((p) => p.slug)

const atlas = drawAtlas(
  places.map((p) => ({
    ...p,
    inset: p.region === 'California',
    order: visits.indexOf(p.slug),
    // A fan of up to three prints: the cover in the middle when it's alone.
    prints: p.photos.slice(0, 3).map((photo, i, all) => ({
      photo,
      tall: photo.image.height > photo.image.width,
      at: all.length === 1 ? 2 : all.length === 2 ? [1, 3][i] : i + 1,
    })),
  })),
)
const pct = (x: number, y: number) => `left: ${((x / atlas.width) * 100).toFixed(2)}%; top: ${((y / atlas.height) * 100).toFixed(2)}%`
---

<Layout
  title="Photography map"
  description="Where Colin Armstrong's photographs were taken, on a map: Panama's rainforest, Patagonia, Meteora and Santorini, Yosemite, Big Sur and the Bay Area, Ontario, Maui and more."
  image="/photos/map.jpg"
  schema={[
    imageGallery(
      places.flatMap((p) => p.photos.map((photo) => ({ src: photo.full, caption: photo.caption, place: p.label }))),
      { path: '/photography/map', name: `Where ${person.name}'s photographs were taken` },
    ),
    breadcrumbs([
      { name: 'Photography', path: '/photography' },
      { name: 'Map', path: '/photography/map' },
    ]),
  ]}
>
  <div class="container wide">
    <!-- map.md.ts repeats this; change both. -->
    <PhotoHead current="map">Where each photo was taken. Pick a place to see its photos.</PhotoHead>

    <div class="atlas" data-atlas>
      <div class="chart">
        <div class="frame" style={`aspect-ratio: ${atlas.width} / ${atlas.height}`}>
          <svg class="map" viewBox={`0 0 ${atlas.width} ${atlas.height}`} aria-hidden="true">
            <g class="coast">{atlas.coasts.map((d) => <path d={d} pathLength="1" />)}</g>
            <rect class="locator" x={atlas.locator.x} y={atlas.locator.y} width={atlas.locator.w} height={atlas.locator.h} />
            <g class="inset">
              <rect class="inset-box" x={atlas.inset.x} y={atlas.inset.y} width={atlas.inset.w} height={atlas.inset.h} />
              <g class="coast">{atlas.inset.coasts.map((d) => <path d={d} pathLength="1" />)}</g>
            </g>
          </svg>
          <span class="inset-name" style={pct(atlas.inset.x + atlas.inset.w - 9, atlas.inset.y + 8)}>California</span>
          {
            atlas.pins.map((p) => (
              <button
                class="dot"
                type="button"
                data-dot={p.slug}
                style={`left: ${p.left.toFixed(2)}%; top: ${p.top.toFixed(2)}%; --i: ${p.order}`}
                aria-label={`${p.label}: ${count(p.photos.length)}`}
                aria-controls={`${p.slug}-photos`}
                aria-expanded="false"
              >
                <span class="fan" aria-hidden="true">
                  {p.prints.map(({ photo, tall, at }) => (
                    <span class:list={['print', `p${at}`, { tall }]}>
                      <Image src={photo.image} alt="" width={tall ? 96 : 144} format="webp" quality={70} loading="lazy" decoding="async" />
                    </span>
                  ))}
                </span>
                <span class="dot-name" aria-hidden="true">
                  {p.name}
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <section class="index" aria-labelledby="places">
        <div class="section-head">
          <h2 id="places">Places</h2>
          <span class="meta">{places.length} places, {count(total)}</span>
        </div>
        <ul class="rows">
          {
            places.map((p) => (
              <li class="place" id={p.slug} data-place-row={p.slug}>
                <button class="place-row" type="button" aria-expanded="false" aria-controls={`${p.slug}-photos`} data-place-toggle>
                  <span class="place-name">
                    <span class="stroke">{p.name}</span><span class="faint">, {p.region}</span>
                  </span>
                  <span class="place-meta">
                    {p.when} · {count(p.photos.length)}
                  </span>
                </button>
                <div class="place-photos" id={`${p.slug}-photos`} role="region" aria-label={`Photos from ${p.label}`}>
                  <div class="clip">
                    <div class="strip" data-photo-set>
                      {p.photos.map((photo) => (
                        <PhotoThumb photo={photo} widths={[200, 400]} sizes="(max-width: 639px) 132px, 112px" />
                      ))}
                    </div>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <PhotoLicense />
  </div>

  <PhotoDevelop />
  <Lightbox />
</Layout>

<!-- The coastlines draw themselves on arrival, then the dots appear in the
     order the places were visited. A page Chrome prerendered waits until
     it's shown. -->
<script is:inline>
  ;(() => {
    const atlas = document.querySelector('[data-atlas]')
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
    const draw = () => atlas.setAttribute('data-draw', '')
    if (document.prerendering) document.addEventListener('prerenderingchange', draw, { once: true })
    else draw()
  })()
</script>

<script>
  const atlas = document.querySelector<HTMLElement>('[data-atlas]')!
  const calm = matchMedia('(prefers-reduced-motion: reduce)')
  const rows = new Map(Array.from(atlas.querySelectorAll<HTMLElement>('[data-place-row]')).map((el) => [el.dataset.placeRow!, el]))
  const dots = new Map(Array.from(atlas.querySelectorAll<HTMLElement>('[data-dot]')).map((el) => [el.dataset.dot!, el]))
  let open: string | undefined

  // One place open at a time: its row unfolds to its photos and its dot
  // turns blue. The address remembers it, so a link can open a place.
  function show(slug: string | undefined, scroll = false) {
    open = slug && rows.has(slug) ? slug : undefined
    for (const [s, row] of rows) {
      const on = s === open
      row.toggleAttribute('data-open', on)
      row.querySelector('[data-place-toggle]')!.setAttribute('aria-expanded', String(on))
      row.querySelector<HTMLElement>('.place-photos')!.inert = !on
    }
    for (const [s, dot] of dots) {
      dot.classList.toggle('is-on', s === open)
      dot.setAttribute('aria-expanded', String(s === open))
    }
    history.replaceState(history.state, '', open ? `#${open}` : location.pathname)
    if (open && scroll) rows.get(open)!.scrollIntoView({ block: 'nearest', behavior: calm.matches ? 'instant' : 'smooth' })
  }

  // Pointing at a place marks its dot, and the other way round.
  function pair(slug: string, on: boolean) {
    rows.get(slug)?.classList.toggle('is-hot', on)
    dots.get(slug)?.classList.toggle('is-hot', on)
  }

  for (const [slug, row] of rows) {
    const toggle = row.querySelector<HTMLElement>('[data-place-toggle]')!
    toggle.addEventListener('click', () => show(open === slug ? undefined : slug))
    toggle.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && pair(slug, true))
    toggle.addEventListener('pointerleave', () => pair(slug, false))
    toggle.addEventListener('focus', () => pair(slug, true))
    toggle.addEventListener('blur', () => pair(slug, false))
  }
  for (const [slug, dot] of dots) {
    dot.addEventListener('click', () => show(open === slug ? undefined : slug, true))
    dot.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && pair(slug, true))
    dot.addEventListener('pointerleave', () => pair(slug, false))
  }

  // The place in the address: on arrival, when a page Chrome prerendered
  // without it is shown for a link that has one, and when it changes.
  const fromAddress = () => show(decodeURIComponent(location.hash.slice(1)) || undefined)
  fromAddress()
  addEventListener('hashchange', fromAddress)
  document.addEventListener('prerenderingchange', fromAddress, { once: true })
</script>

<style>
  .atlas {
    display: grid;
    gap: 48px;
    margin-top: 40px;
  }

  /* Wide screens: the map holds still while the places scroll beside it. */
  @media (min-width: 1024px) {
    .atlas {
      grid-template-columns: minmax(0, 1fr) 320px;
      align-items: start;
    }

    .chart {
      position: sticky;
      top: 32px;
    }

    /* In the narrow column, each place's dates go under its name. */
    .place-row {
      flex-direction: column;
    }
  }

  .frame {
    position: relative;
  }

  .map {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Coastlines in hairline ink, over the faintest wash of land. */
  .coast path {
    fill: color-mix(in srgb, var(--ink) 3.5%, transparent);
    stroke: color-mix(in srgb, var(--ink) 40%, transparent);
    stroke-width: 0.8;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .inset-box {
    fill: var(--bg);
    stroke: var(--line-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .locator {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .inset-name {
    position: absolute;
    transform: translateX(-100%);
    color: var(--ink-3);
    font-size: 13.5px;
    font-style: italic;
    line-height: 1;
    pointer-events: none;
  }

  /* A place: a small ink dot, with room around it for a finger. */
  .dot {
    position: absolute;
    z-index: 1;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }

  .dot::before {
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0 1.5px var(--bg);
    content: '';
    transition:
      transform 300ms var(--ease),
      background-color 200ms;
  }

  .dot:is(:hover, :focus-visible, .is-hot, .is-on) {
    z-index: 3;
  }

  .dot:is(:hover, :focus-visible, .is-hot)::before {
    transform: scale(1.35);
  }

  .dot.is-on::before {
    background: var(--blue);
    transform: scale(1.5);
  }

  .dot:focus-visible {
    outline: 1.5px solid var(--blue);
    outline-offset: 1px;
  }

  .dot-name {
    position: absolute;
    top: 50%;
    left: 20px;
    color: var(--ink);
    font-size: 15px;
    line-height: 1;
    white-space: nowrap;
    text-shadow:
      0 0 2px var(--bg),
      0 0 6px var(--bg),
      0 0 12px var(--bg);
    opacity: 0;
    transform: translate(-4px, -50%);
    transition:
      opacity 180ms,
      transform 320ms var(--ease);
    pointer-events: none;
  }

  .dot:is(:hover, :focus-visible, .is-hot, .is-on) .dot-name {
    opacity: 1;
    transform: translate(0, -50%);
  }

  /* Pointing at a place fans out a few of its prints, as "photography"
     does on the home page. */
  .fan {
    position: absolute;
    bottom: calc(100% - 2px);
    left: 50%;
    pointer-events: none;
  }

  .print {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 3px;
    border-radius: 2px;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.12),
      0 10px 24px rgb(0 0 0 / 0.18);
    opacity: 0;
    transform: translate(-50%, 10px) scale(0.86);
    transition:
      opacity 180ms ease,
      transform 460ms var(--ease);
  }

  .print :global(img) {
    display: block;
    width: 72px;
    max-width: none;
    height: 50px;
    object-fit: cover;
  }

  .print.tall :global(img) {
    width: 44px;
    height: 62px;
  }

  @media (hover: hover) {
    .dot:is(:hover, .is-hot) .print {
      opacity: 1;
    }

    .dot:is(:hover, .is-hot) .p1 {
      transform: translate(-114%, -2px) rotate(-8deg);
    }

    .dot:is(:hover, .is-hot) .p2 {
      transform: translate(-50%, -12px) rotate(1.5deg);
      transition-delay: 40ms;
    }

    .dot:is(:hover, .is-hot) .p3 {
      transform: translate(14%, -2px) rotate(7deg);
      transition-delay: 80ms;
    }
  }

  /* Arriving: every coastline draws itself at once, the land washes in,
     the inset follows, then the dots, in the order they were visited. */
  .atlas[data-draw] .coast path {
    animation:
      coast-draw 1.9s cubic-bezier(0.45, 0.1, 0.25, 1) backwards,
      land-wash 900ms ease 1.2s backwards;
  }

  .atlas[data-draw] .inset .coast path {
    animation-delay: 500ms, 1.5s;
  }

  .atlas[data-draw] :is(.inset-box, .locator, .inset-name) {
    animation: fade 700ms ease 400ms backwards;
  }

  .atlas[data-draw] .dot::before {
    animation: dot-in 520ms var(--ease) backwards;
    animation-delay: calc(900ms + var(--i) * 70ms);
  }

  @keyframes coast-draw {
    from {
      stroke-dasharray: 1 1;
      stroke-dashoffset: 1;
      fill-opacity: 0;
    }
    to {
      stroke-dasharray: 1 1;
      stroke-dashoffset: 0;
      fill-opacity: 0;
    }
  }

  @keyframes land-wash {
    from {
      fill-opacity: 0;
    }
  }

  @keyframes dot-in {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
  }

  /* The places, in rows. */
  .index .section-head {
    padding-top: 4px;
  }

  .place {
    scroll-margin-top: 24px;
  }

  .place-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1px 16px;
    width: 100%;
    padding: 12px 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 18px;
    text-align: left;
    cursor: pointer;
  }

  .place-row:focus-visible {
    outline: none;
  }

  .place-row:hover .stroke,
  .place.is-hot .stroke {
    background-position: left bottom;
    background-size: 100% 1px;
    color: var(--blue);
  }

  .place[data-open] .stroke {
    color: var(--ink);
    background-image: linear-gradient(var(--ink), var(--ink));
    background-position: left bottom;
    background-size: 100% 1px;
  }

  .place-meta {
    color: var(--ink-2);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }

  /* A place's photos unfold under its name. Without a script, every place
     shows them. */
  @media (scripting: enabled) {
    .place-photos {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 480ms var(--ease);
    }

    .place[data-open] .place-photos {
      grid-template-rows: 1fr;
    }
  }

  .clip {
    min-height: 0;
    overflow: hidden;
  }

  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 2px 0 16px;
  }

  .strip :global(.thumb) {
    flex: none;
    height: 72px;
  }

  .strip :global(.thumb img) {
    width: auto;
    height: 100%;
  }

  @media (max-width: 1023px) {
    .strip :global(.thumb) {
      height: 88px;
    }
  }

  @media (max-width: 639px) {
    .atlas {
      gap: 36px;
      margin-top: 28px;
    }

    .chart {
      margin-inline: calc(var(--gutter) * -1);
    }

    .inset-name {
      font-size: 11px;
    }

    .dot-name {
      font-size: 14px;
    }
  }
</style>
