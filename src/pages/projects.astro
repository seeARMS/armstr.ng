---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import Mark from '@/components/Mark.astro'
import WorkList from '@/components/WorkList.astro'
import { appearances, projects, work } from '@/data/profile'
import { anchor, monthYear, venue } from '@/lib/format'
import { breadcrumbs, projectList } from '@/lib/schema'

// The Markdown version of this page (projects.md.ts) repeats its copy; change both.
const since = Math.min(...work.map((role) => role.from))
const out = 'M5 11 11 5M6 5h5v5'
---

<Layout
  title="Projects, work and press"
  description="Colin Armstrong's side projects (Appears, heade.rs, Draftside, Council), his work at Paragraph, Mirror, Google and Coinbase, and his podcast and press appearances."
  schema={[breadcrumbs([{ name: 'Projects & Work', path: '/projects' }]), projectList()]}
>
  <div class="container">
    <header class="page-head">
      <h1>Projects & Work</h1>
      <p class="summary">What I'm building on the side, where I've worked, and where I've talked about it.</p>
    </header>

    <section class="section" aria-labelledby="projects">
      <div class="section-head">
        <h2 id="projects">Projects</h2>
        <span class="meta">Small products & experiments I've built</span>
      </div>
      <ul class="rows">
        {
          projects.map((project) => (
            <li>
              <a class="project" href={project.href} rel="noopener">
                <Mark logo={project.logo} size={26} />
                <span class="text">
                  <span class="name">
                    <span class="stroke">{project.name}</span>
                    <time
                      class="project-date"
                      datetime={project.started}
                      aria-label={`Started ${monthYear(project.started)}`}
                    >
                      {monthYear(project.started)}
                    </time>
                  </span>
                  <span class="about">{project.summary}</span>
                </span>
                <span class="domain">
                  {project.href.replace(/^https?:\/\//, '')}
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path
                      d={out}
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="work">
      <!-- A link to one role (/projects#google) lands at the top of Work, not
           on the row itself, so the section reads from its heading. The row
           then opens, and WorkList.astro brings it up if it would run off
           the screen. -->
      {work.map((role) => <span class="role-anchor" id={anchor(role.company)} />)}
      <div class="section-head">
        <h2 id="work">Work</h2>
        <span class="meta">Since {since}</span>
      </div>
      <p class="lead">
        Selected roles where I worked on payments, anti-abuse, privacy, and systems that reached large numbers of
        people.
      </p>
      <WorkList roles={work} variant="expand" />
    </section>

    <section class="section" aria-labelledby="press">
      <div class="section-head">
        <h2 id="press">Podcasts & press</h2>
      </div>
      <ol class="rows">
        {
          appearances.map((a) => (
            <li>
              <a class="appearance" href={a.href} rel="noopener">
                <span class="text">
                  <span class="title">
                    <span class="stroke">{a.title}</span>
                  </span>
                  <span class="where">{venue(a)}</span>
                </span>
                <time class="date" datetime={a.date}>
                  {monthYear(a.date)}
                </time>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Layout>

<style>
  .project {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
  }

  .text {
    display: grid;
    flex: 1;
    gap: 2px;
    min-width: 0;
  }

  .name {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px 12px;
    font-size: 20px;
    line-height: 1.3;
  }

  .project-date {
    color: var(--ink-3);
    font-size: 15px;
    white-space: nowrap;
  }

  .about {
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .domain {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 4px;
    color: var(--ink-3);
    font-size: 16px;
  }

  .domain svg {
    width: 15px;
    height: 15px;
    transition: transform 220ms var(--ease);
  }

  .project:hover .domain {
    color: var(--ink);
  }

  .project:hover .domain svg {
    transform: translate(2px, -2px);
  }

  .role-anchor {
    display: block;
    scroll-margin-top: 32px;
  }

  .lead {
    max-width: 34em;
    margin: 18px 0 6px;
    color: var(--ink-2);
    font-size: 18px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .lead + :global(.work) {
    border-top: 1px solid var(--line);
  }

  .appearance {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 13px 0;
  }

  .title {
    font-size: 19px;
    line-height: 1.35;
    text-wrap: pretty;
  }

  .where {
    color: var(--ink-2);
    font-size: 16px;
  }

  .date {
    flex: none;
    margin-left: auto;
    color: var(--ink-3);
    font-size: 16px;
  }

  @media (max-width: 639px) {
    .project {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 4px 14px;
    }

    .project :global(.mark) {
      margin-top: 2px;
    }

    .text {
      flex-basis: calc(100% - 40px);
    }

    .domain {
      margin-left: 40px;
      font-size: 15px;
    }

    .name {
      font-size: 19px;
    }

    .about {
      font-size: 16px;
    }

    .appearance {
      gap: 16px;
    }

    .title {
      font-size: 18px;
    }

    .where,
    .date {
      font-size: 15px;
    }
  }
</style>
