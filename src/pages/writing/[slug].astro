---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import PageToc from '@/components/PageToc.astro'
import PostList from '@/components/PostList.astro'
import SubscribeForm from '@/components/SubscribeForm.astro'
import { getColinArticlesWithContent } from '@/lib/getAllArticles'
import { longDate, postDescription, readingTime } from '@/lib/format'
import { blogPosting, breadcrumbs } from '@/lib/schema'
import { highlight } from '@/lib/highlight'
import { optimizeImages } from '@/lib/post-images'
import { headingIds, headingLinks } from '@/lib/headings'
import { followLinks, mentions } from '@/lib/links'

export async function getStaticPaths() {
  const posts = await getColinArticlesWithContent()
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      ...post,
      allPosts: posts
        .filter((p) => p.slug !== post.slug && !p.unlisted)
        .map(({ html: _, markdown: __, unlisted: ___, ...rest }) => ({ ...rest, link: `/writing/${rest.slug}` })),
    },
  }))
}

const { slug } = Astro.params
const { title, subtitle, html, isoDate, updatedIso, allPosts } = Astro.props
const minutes = html ? readingTime(html) : 0
const body = html ? await optimizeImages(await highlight(headingLinks(headingIds(followLinks(html))))) : ''
const path = `/writing/${slug}`
// Shown only for a post edited on a later day (src/data/posts.ts).
const updated = longDate(updatedIso) === longDate(isoDate) ? undefined : updatedIso
const image = `/og/${slug}.jpg`
const description = postDescription(title, subtitle, html ?? '')
const words = html ? html.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length : undefined
const schema = [
  blogPosting({ path, title, description, image, published: isoDate, modified: updatedIso, words, mentions: mentions(html ?? '') }),
  breadcrumbs([
    { name: 'Writing', path: '/writing' },
    { name: title, path },
  ]),
]
---

<Layout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedDate={isoDate}
  modifiedDate={updatedIso}
  schema={schema}
  noindex={!html}
>
  <article class="post">
    <header class="page-head">
      <a class="back" href="/writing">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="M13 8H3.5M7.5 4l-4 4 4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Writing
      </a>
      <h1>{title}</h1>
      {subtitle && <p class="summary">{subtitle}</p>}
      <p class="meta">
        <time datetime={isoDate}>{longDate(isoDate)}</time>
        {
          updated && (
            <span>
              Updated <time datetime={updated}>{longDate(updated)}</time>
            </span>
          )
        }
        {minutes > 0 && <span>{minutes} minute read</span>}
      </p>
    </header>

    {
      html ? (
        <div class="prose body" set:html={body} />
      ) : (
        <p class="empty">This post's text couldn't be loaded when the site was built.</p>
      )
    }
    <p class="print-source">Colin Armstrong · {new URL(path, Astro.site).href}</p>
  </article>

  <PageToc />

  <aside class="after" aria-label="More">
    <section class="follow" aria-labelledby="subscribe">
      <h2 id="subscribe">Subscribe</h2>
      <p class="muted">Get new posts delivered to your inbox.</p>
      <SubscribeForm />
    </section>

    {
      allPosts.length > 0 && (
        <section class="more-posts" aria-labelledby="keep-reading">
          <div class="section-head">
            <h2 id="keep-reading">Keep reading</h2>
          </div>
          <PostList posts={allPosts} />
        </section>
      )
    }
  </aside>
</Layout>

<script>
  import { mediumDate } from '@/lib/format'

  // Once a post image has arrived, drop its blurred preview, so the preview
  // can't show through the transparent parts of a screenshot.
  for (const img of document.querySelectorAll<HTMLImageElement>('.prose img[data-blur]')) {
    const arrived = () => {
      img.style.removeProperty('background-image')
      delete img.dataset.blur
    }
    if (img.complete && img.naturalWidth) arrived()
    else img.addEventListener('load', arrived, { once: true })
  }

  const prose = document.querySelector<HTMLElement>('.prose.body')
  const here = () => location.origin + location.pathname

  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text)
      return true
    } catch {
      return false
    }
  }

  // The link beside a heading copies the address of that section. Without a
  // clipboard it's an ordinary link to it.
  prose?.addEventListener('click', async (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a.anchor')
    if (!a) return
    e.preventDefault()
    if (!(await copy(here() + a.hash))) return void (location.hash = a.hash)
    history.replaceState(history.state, '', a.hash)
    a.dataset.copied = ''
    a.setAttribute('aria-label', 'Link copied')
    setTimeout(() => {
      delete a.dataset.copied
      a.setAttribute('aria-label', 'Link to this section')
    }, 1600)
  })

  // Printing: each link in the post gets a number, and the addresses are
  // listed after the post, since paper can't be clicked. Taken out again
  // once the print dialog closes.
  if (prose) {
    let notes: HTMLElement | undefined
    addEventListener('beforeprint', () => {
      if (notes) return
      const urls: string[] = []
      for (const a of prose.querySelectorAll<HTMLAnchorElement>('a[href]:not(.anchor)')) {
        if (!/^https?:/.test(a.href) || a.href.startsWith(`${here()}#`)) continue
        const n = urls.indexOf(a.href) + 1 || urls.push(a.href)
        const ref = document.createElement('sup')
        ref.className = 'print-ref'
        ref.textContent = String(n)
        a.after(ref)
      }
      if (!urls.length) return
      notes = document.createElement('section')
      notes.className = 'print-notes'
      notes.innerHTML = '<h2>Links</h2><ol></ol>'
      const list = notes.querySelector('ol')!
      for (const url of urls) list.append(Object.assign(document.createElement('li'), { textContent: url }))
      prose.after(notes)
    })
    addEventListener('afterprint', () => {
      notes?.remove()
      notes = undefined
      for (const ref of prose.querySelectorAll('.print-ref')) ref.remove()
    })
  }

  // Hovering a link to another page of this site shows what's there: its
  // heading and opening lines, read from the Markdown version built for
  // agents (/projects → /projects.md). Only with a mouse, since a tap follows
  // the link anyway. Links off the site keep the browser's own status bar.
  if (prose && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const card = document.createElement('div')
    card.className = 'link-card'
    card.hidden = true
    card.setAttribute('aria-hidden', 'true')
    card.innerHTML = '<p class="link-card-title"></p><p class="link-card-text"></p><p class="link-card-meta"></p>'
    const [titleEl, textEl, metaEl] = Array.from(card.children) as HTMLElement[]
    document.body.append(card)

    type Preview = { title: string; text: string; meta: string }
    const previews = new Map<string, Promise<Preview | undefined>>()

    // The page a link stands for, when it's another page of this site.
    function pageOf(a: HTMLAnchorElement) {
      if (a.classList.contains('anchor')) return
      let url: URL
      try {
        url = new URL(a.href)
      } catch {
        return
      }
      if (url.host !== location.host && url.hostname !== 'armstr.ng') return
      const path = url.pathname.replace(/(.)\/+$/, '$1')
      if (path === location.pathname || /\.\w+$/.test(path)) return
      return path
    }

    // Markdown links and emphasis, read as plain text.
    const plain = (s: string) =>
      s
        .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
        .replace(/[*_`]+/g, '')
        .trim()

    function preview(path: string) {
      let p = previews.get(path)
      if (!p) {
        p = fetch(path === '/' ? '/index.md' : `${path}.md`)
          .then((res) => (res.ok ? res.text() : Promise.reject()))
          .then((md) => {
            const [, head = '', body = md] = md.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/) ?? []
            const blocks = body.split(/\n{2,}/).map((b) => b.trim())
            const h1 = blocks.findIndex((b) => b.startsWith('# '))
            const text = blocks.slice(h1 + 1).find((b) => b && !/^(#|[-*>|]|!\[|```)/.test(b))
            const published = head.match(/^published: "([^"]+)"/m)?.[1]
            if (h1 < 0) return undefined
            return {
              title: plain(blocks[h1].slice(2)),
              text: text ? plain(text) : '',
              meta: published ? mediumDate(published) : `armstr.ng${path === '/' ? '' : path}`,
            }
          })
          .catch(() => undefined)
        previews.set(path, p)
      }
      return p
    }

    let current: HTMLAnchorElement | undefined
    let showTimer = 0

    // Where the pointer was over the link, or undefined for keyboard focus.
    let pointerX: number | undefined

    function place(a: HTMLAnchorElement) {
      // Below the link (all of it, when it wraps), or above when there's no
      // room, starting near the pointer.
      const rects = Array.from(a.getClientRects()).filter((r) => r.width > 0)
      const first = rects[0] ?? a.getBoundingClientRect()
      const last = rects[rects.length - 1] ?? first
      card.hidden = false
      const w = card.offsetWidth
      const h = card.offsetHeight
      const x = Math.min(Math.max((pointerX ?? first.left + 24) - 24, 8), innerWidth - w - 8)
      const below = last.bottom + 10 + h < innerHeight - 8
      const y = below ? last.bottom + 10 : first.top - h - 10
      card.style.left = `${x + scrollX}px`
      card.style.top = `${y + scrollY}px`
      card.dataset.side = below ? 'below' : 'above'
    }

    function hide() {
      clearTimeout(showTimer)
      current = undefined
      card.hidden = true
    }

    function enter(a: HTMLAnchorElement) {
      const path = pageOf(a)
      if (!path || a === current) return
      hide()
      current = a
      const ready = preview(path)
      // A short pause, so passing over a link on the way elsewhere shows nothing.
      showTimer = window.setTimeout(async () => {
        const p = await ready
        if (!p || current !== a) return
        titleEl.textContent = p.title
        textEl.textContent = p.text
        textEl.hidden = !p.text
        metaEl.textContent = p.meta
        place(a)
      }, 350)
    }

    prose.addEventListener('pointerover', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href]')
      pointerX = e.clientX
      if (a) enter(a)
    })
    prose.addEventListener('pointerout', (e) => {
      if (current && !current.contains(e.relatedTarget as Node | null)) hide()
    })
    prose.addEventListener('focusin', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href]')
      pointerX = undefined
      if (a?.matches(':focus-visible')) enter(a)
    })
    prose.addEventListener('focusout', hide)
    addEventListener('scroll', hide, { passive: true })
    addEventListener('resize', hide)
    prose.addEventListener('click', hide)
  }

  // Select a passage and "Copy link" appears above it: a link that opens the
  // post scrolled to that passage, highlighted (a text fragment, #:~:text=).
  // Only with a mouse: phones' own selection menus already offer this.
  if (prose && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const button = document.createElement('button')
    button.type = 'button'
    button.className = 'passage-link'
    button.hidden = true
    button.innerHTML =
      '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.75 9.25a2.6 2.6 0 0 0 3.7 0l2.1-2.1a2.6 2.6 0 0 0-3.7-3.7l-.85.85M9.25 6.75a2.6 2.6 0 0 0-3.7 0l-2.1 2.1a2.6 2.6 0 0 0 3.7 3.7l.85-.85" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg><span>Copy link</span>'
    const label = button.querySelector('span')!
    document.body.append(button)

    const WORD = /[\p{L}\p{N}]/u
    const squash = (s: string) => s.replace(/\s+/g, ' ').trim()
    const encode = (s: string) => encodeURIComponent(s).replace(/-/g, '%2D')
    const BLOCK = 'p, li, h1, h2, h3, h4, blockquote, figcaption, pre, td, th'

    // The fragment for a selection: the whole passage if it's short, else its
    // first and last few words. Fragments match whole words, so a word the
    // selection cuts into is left out, and a start that appears earlier in
    // the post gets the words before it as a prefix.
    function fragment(range: Range): string | undefined {
      const lines = range
        .toString()
        .split(/\n+/)
        .map(squash)
        .filter(Boolean)
      if (!lines.length) return
      const cutStart = isText(range.startContainer) && WORD.test(range.startContainer.data[range.startOffset - 1] ?? '')
      const cutEnd = isText(range.endContainer) && WORD.test(range.endContainer.data[range.endOffset] ?? '')
      const words = (line: string) => line.split(' ')
      let start: string
      let end = ''
      if (lines.length === 1) {
        const all = words(lines[0]).slice(cutStart ? 1 : 0, cutEnd ? -1 : undefined)
        if (!all.length) return
        start = all.slice(0, all.length <= 8 ? undefined : 4).join(' ')
        if (all.length > 8) end = all.slice(-4).join(' ')
      } else {
        const head = words(lines[0]).slice(cutStart ? 1 : 0)
        const tail = words(lines[lines.length - 1]).slice(0, cutEnd ? -1 : undefined)
        if (!head.length || !tail.length) return
        start = head.slice(0, 4).join(' ')
        end = tail.slice(-4).join(' ')
      }

      let prefix = ''
      const text = squash(prose!.textContent ?? '').toLowerCase()
      if (!cutStart && text.indexOf(start.toLowerCase()) !== text.lastIndexOf(start.toLowerCase())) {
        const block = (isText(range.startContainer) ? range.startContainer.parentElement : (range.startContainer as Element))?.closest(BLOCK)
        if (block) {
          const before = document.createRange()
          before.setStart(block, 0)
          before.setEnd(range.startContainer, range.startOffset)
          prefix = squash(before.toString()).split(' ').filter(Boolean).slice(-3).join(' ')
        }
      }
      return `${prefix ? `${encode(prefix)}-,` : ''}${encode(start)}${end ? `,${encode(end)}` : ''}`
    }

    const isText = (n: Node): n is Text => n.nodeType === Node.TEXT_NODE

    let link = ''
    let hideTimer = 0

    function hide() {
      button.hidden = true
      link = ''
    }

    function show() {
      const sel = getSelection()
      if (!sel || sel.isCollapsed || !sel.rangeCount) return hide()
      const range = sel.getRangeAt(0)
      if (!prose!.contains(range.commonAncestorContainer)) return hide()
      const f = fragment(range)
      if (!f) return hide()
      link = `${here()}#:~:text=${f}`
      clearTimeout(hideTimer)
      label.textContent = 'Copy link'
      delete button.dataset.copied

      // Centered above the selection's first line, or below its last when
      // there's no room above.
      const rects = Array.from(range.getClientRects()).filter((r) => r.width > 0)
      if (!rects.length) return hide()
      const top = rects[0]
      const bottom = rects[rects.length - 1]
      button.hidden = false
      const w = button.offsetWidth
      const h = button.offsetHeight
      const box = prose!.getBoundingClientRect()
      const span = rects.length > 1 ? { left: box.left, right: box.right } : top
      const x = Math.min(Math.max((span.left + span.right) / 2 - w / 2, 8), innerWidth - w - 8)
      const above = top.top - h - 10 > 8
      const y = above ? top.top - h - 10 : bottom.bottom + 10
      button.style.left = `${x + scrollX}px`
      button.style.top = `${y + scrollY}px`
      button.dataset.side = above ? 'above' : 'below'
    }

    // After the selection settles: on mouse up, or a shift-arrow key.
    prose.addEventListener('mouseup', () => setTimeout(show))
    prose.addEventListener('keyup', (e) => {
      if (e.shiftKey || e.key === 'Shift') show()
    })
    document.addEventListener('selectionchange', () => {
      const sel = getSelection()
      if (!button.hidden && (!sel || sel.isCollapsed)) hide()
    })
    // Keep the selection when the button is pressed.
    button.addEventListener('mousedown', (e) => e.preventDefault())
    button.addEventListener('click', async () => {
      if (!link || !(await copy(link))) return
      label.textContent = 'Copied'
      button.dataset.copied = ''
      hideTimer = window.setTimeout(hide, 1200)
    })
    addEventListener('resize', hide)
  }
</script>

<style>
  .post,
  .after {
    width: 100%;
    max-width: calc(var(--post) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* The back link sits in the space above the title, so the title starts
     where the Writing page's heading does (.page-head's padding, less the
     link's 24px line and its 20px gap); clicking into a post keeps the
     titles in the same place. */
  .page-head {
    padding-top: 52px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 20px;
    color: var(--ink-2);
    font-size: 16px;
  }

  .back svg {
    width: 15px;
    height: 15px;
    transition: transform 220ms var(--ease);
  }

  .back:hover {
    color: var(--blue);
  }

  .back:hover svg {
    transform: translateX(-3px);
  }

  /* The title at display size, set tight, with the subtitle as an italic
     standfirst under it. */
  .page-head h1 {
    width: fit-content;
    font-size: 64px;
    font-weight: 340;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .page-head .summary {
    margin-top: 18px;
    font-size: 24px;
    font-style: italic;
    line-height: 1.45;
  }

  /* The date and reading time, after a short rule: a quiet line that
     closes the header instead of a full-width hairline. */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 0;
    margin-top: 32px;
    color: var(--ink-3);
    font-size: 16px;
  }

  .meta::before {
    content: '';
    width: 28px;
    height: 1px;
    margin-right: 14px;
    background: var(--ink);
  }

  .meta > * + *::before {
    content: '·';
    margin-inline: 10px;
  }

  .body {
    margin-top: 52px;
  }

  .empty {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

  .after {
    display: grid;
    /* Never wider than the column: an auto track would grow to the subscribe
       field's natural width and push the page sideways on phones. */
    grid-template-columns: minmax(0, 1fr);
    gap: 72px;
    margin-top: 88px;
  }

  .follow {
    padding-top: 28px;
    border-top: 1px solid var(--ink);
  }

  .follow h2 {
    font-size: 30px;
    font-weight: 380;
    letter-spacing: -0.015em;
  }

  .follow p {
    margin: 6px 0 20px;
    font-size: 18px;
  }

  .follow :global(.subscribe) {
    max-width: 500px;
  }

  @media (max-width: 639px) {
    /* The same sum with the phone's 56px padding, and a tighter gap. */
    .page-head {
      padding-top: 20px;
    }

    .back {
      margin-bottom: 12px;
    }

    .page-head h1 {
      font-size: 42px;
    }

    .page-head .summary {
      font-size: 20px;
    }

    .meta {
      margin-top: 24px;
    }

    .body {
      margin-top: 36px;
    }
  }
</style>
